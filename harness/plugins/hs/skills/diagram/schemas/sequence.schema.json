{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hs-diagram/sequence.schema.json",
  "title": "hs:diagram sequence IR",
  "description": "Ordered interactions between participants over time -- request/response timing.",
  "allOf": [{ "$ref": "#/$defs/envelope" }],
  "type": "object",
  "properties": {
    "diagram_type": { "const": "sequence" },
    "participants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/safe_text" },
          "role": {
            "type": "string",
            "enum": ["client", "service", "database", "gateway", "external", "queue"]
          }
        }
      }
    },
    "messages": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["from", "to", "label"],
        "properties": {
          "from": { "$ref": "#/$defs/id" },
          "to": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/safe_text" },
          "kind": {
            "type": "string",
            "enum": ["sync-call", "async-signal", "return", "self-call", "error"]
          }
        }
      }
    }
  },
  "required": ["participants"]
}
