{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hs-diagram/workflow.schema.json",
  "title": "hs:diagram workflow IR",
  "description": "Multi-step execution across lanes: steps, decisions, and transitions between them.",
  "allOf": [{ "$ref": "#/$defs/envelope" }],
  "type": "object",
  "properties": {
    "diagram_type": { "const": "workflow" },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/safe_text" },
          "role": {
            "type": "string",
            "enum": ["user", "frontend", "orchestrator", "worker", "approver", "system"]
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/safe_text" },
          "lane": { "$ref": "#/$defs/id" },
          "kind": {
            "type": "string",
            "enum": ["start", "action", "decision", "wait", "subprocess",
                     "terminal-success", "terminal-failure"]
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "$ref": "#/$defs/id" },
          "to": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/safe_text" },
          "condition": { "$ref": "#/$defs/safe_text" },
          "kind": {
            "type": "string",
            "enum": ["normal", "branch-true", "branch-false", "retry", "exception"]
          }
        }
      }
    }
  },
  "required": ["steps"]
}
