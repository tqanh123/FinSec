{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hs-diagram/lifecycle.schema.json",
  "title": "hs:diagram lifecycle IR",
  "description": "Finite state machines: states and the transitions between them.",
  "allOf": [{ "$ref": "#/$defs/envelope" }],
  "type": "object",
  "properties": {
    "diagram_type": { "const": "lifecycle" },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/safe_text" },
          "kind": {
            "type": "string",
            "enum": ["initial", "active", "waiting", "failure-recoverable",
                     "failure-fatal", "terminal-success", "terminal-cancelled"]
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "$ref": "#/$defs/id" },
          "to": { "$ref": "#/$defs/id" },
          "event": { "$ref": "#/$defs/safe_text" },
          "kind": {
            "type": "string",
            "enum": ["normal", "retry", "timeout", "cancel", "fail"]
          }
        }
      }
    }
  },
  "required": ["states"]
}
