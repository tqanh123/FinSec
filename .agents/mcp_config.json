{
  "mcpServers": {
    "context7": {
      "serverUrl": "https://mcp.context7.com/mcp"
    },
    "github": {
      "serverUrl": "https://api.githubcopilot.com/mcp/"
    },
    "alpaca-us": {
      "command": "uvx",
      "args": ["alpaca-mcp-server"],
      "env": {
        "ALPACA_API_KEY": "${ALPACA_API_KEY}",
        "ALPACA_SECRET_KEY": "${ALPACA_SECRET_KEY}",
        "ALPACA_PAPER_TRADE": "true",
        "ALPACA_TOOLSETS": "stock-data,options-data,corporate-actions,news,watchlists,trading"
      }
    },
    "edgartools-us": {
      "command": "uvx",
      "args": ["--from", "edgartools[ai]", "edgartools-mcp"],
      "env": {
        "EDGAR_IDENTITY": "FinSecAlphaRadar research@yourdomain.com"
      }
    },
    "maverick-quant": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/wshobson/maverick-mcp@v1.1.0",
        "maverick-mcp",
        "--transport",
        "stdio"
      ]
    },
    "vnstock-vn": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/mrgoonie/vnstock-agent.git", "vnstock-mcp"],
      "env": {
        "VNSTOCK_DATA_SOURCE": "VCI"
      }
    },
    "ssi-fastconnect-vn": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/archiephan78/ssi-stock-mcp-server.git", "ssi-stock-mcp-server"],
      "env": {
        "SSI_CONSUMER_ID": "${SSI_CONSUMER_ID}",
        "SSI_CONSUMER_SECRET": "${SSI_CONSUMER_SECRET}"
      },
      "disabled": true
    },
    "huggingface": {
      "serverUrl": "https://huggingface.co/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "disabled": true
    },
    "wandb": {
      "command": "uvx",
      "args": ["wandb-mcp-server"],
      "disabled": true
    }
  }
}
