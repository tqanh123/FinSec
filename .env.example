# --- US Market (Alpaca & SEC EDGAR) ---
ALPACA_API_KEY=your_alpaca_paper_key
ALPACA_SECRET_KEY=your_alpaca_paper_secret
ALPACA_PAPER_TRADE=true
EDGAR_IDENTITY="FinSecAlphaRadar research@yourdomain.com"

# --- Vietnam Market (Vnstock & SSI FastConnect) ---
VNSTOCK_DATA_SOURCE=VCI
SSI_CONSUMER_ID=your_ssi_consumer_id
SSI_CONSUMER_SECRET=your_ssi_consumer_secret
SSI_PRIVATE_KEY_PATH=./configs/ssi_private_key.pem

# --- Storage & Observability ---
QDRANT_URL=http://localhost:6333
TIMESCALE_DSN=postgresql://finsec:finsec_local_password@localhost:5432/alpharadar
WANDB_API_KEY=your_wandb_api_key
LANGFUSE_PUBLIC_KEY=your_langfuse_pub_key
LANGFUSE_SECRET_KEY=your_langfuse_sec_key
